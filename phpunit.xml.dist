<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/13.0/phpunit.xsd"
    backupGlobals="false"
    bootstrap="vendor/autoload.php"
    colors="true"
    processIsolation="false"
    stopOnFailure="false"
    executionOrder="random"
    failOnWarning="true"
    displayDetailsOnTestsThatTriggerDeprecations="false"
    failOnDeprecation="false"
    failOnRisky="true"
    failOnEmptyTestSuite="true"
    beStrictAboutOutputDuringTests="true"
    cacheDirectory=".phpunit.cache"
    backupStaticProperties="false"
>
    <testsuites>
        <testsuite name="Arazzo Contracts Test Suite">
            <directory>packages/contracts/tests</directory>
        </testsuite>
        <testsuite name="Arazzo Expression Test Suite">
            <directory>packages/expression/tests</directory>
        </testsuite>
        <testsuite name="Arazzo Document Test Suite">
            <directory>packages/document/tests</directory>
        </testsuite>
        <testsuite name="Arazzo Core Test Suite">
            <directory>packages/core/tests</directory>
        </testsuite>
        <testsuite name="Arazzo Laravel Test Suite">
            <directory>packages/laravel/tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">packages/contracts/src</directory>
            <directory suffix=".php">packages/expression/src</directory>
            <directory suffix=".php">packages/document/src</directory>
            <directory suffix=".php">packages/core/src</directory>
            <directory suffix=".php">packages/laravel/src</directory>
        </include>
    </source>
    <php>
        <!-- cebe/php-openapi emits PHP-8.4 nullable-param deprecations on
             class load; they are vendor noise, not suite signal. -->
        <ini name="error_reporting" value="24575"/>
        <!-- Aggregating both package suites in one parent process needs
             more headroom than Herd's 128M CLI default. -->
        <ini name="memory_limit" value="512M"/>
    </php>
</phpunit>
