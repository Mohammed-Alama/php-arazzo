#!/bin/sh
#
# install-gh-shim — put the intake gate ahead of the real `gh` on PATH.
#
# Symlinks scripts/bin/gh into ~/.arazzo/bin and prints the one line to add to
# your shell profile. Idempotent, and safe to re-run after moving the repo.
#
# GH_SHIM_DIR overrides the install directory (used by the tests).

set -eu

resolve_script_path() {
    target=$0

    while [ -L "$target" ]; do
        dir=$(cd "$(dirname "$target")" && pwd)
        link=$(readlink "$target")

        case "$link" in
            /*) target=$link ;;
            *)  target="$dir/$link" ;;
        esac
    done

    printf '%s\n' "$(cd "$(dirname "$target")" && pwd)/$(basename "$target")"
}

SCRIPT=$(resolve_script_path)
SRC=$(dirname "$SCRIPT")/gh
BIN_DIR=${GH_SHIM_DIR:-$HOME/.arazzo/bin}
TARGET="$BIN_DIR/gh"

if [ ! -f "$SRC" ]; then
    printf 'install-gh-shim: %s not found\n' "$SRC" >&2
    exit 1
fi

chmod +x "$SRC"
mkdir -p "$BIN_DIR"

existing=$(readlink "$TARGET" 2>/dev/null || true)

if [ "$existing" = "$SRC" ]; then
    printf 'already installed: %s -> %s\n' "$TARGET" "$SRC"
else
    rm -f "$TARGET"
    ln -s "$SRC" "$TARGET"
    printf 'installed %s -> %s\n' "$TARGET" "$SRC"
fi

printf '\nPut the shim ahead of the real gh by adding this to your shell profile:\n\n'
printf '    export PATH="%s:$PATH"\n\n' "$BIN_DIR"
printf 'Then check it is first:  command -v gh   (should print %s/gh)\n' "$BIN_DIR"
printf 'To uninstall:            rm -f %s\n' "$TARGET"
