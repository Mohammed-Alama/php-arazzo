#!/usr/bin/env php
<?php

declare(strict_types=1);

use Alama\Tools\IssueIntake\Schema;
use Symfony\Component\Yaml\Yaml;

/**
 * Generates the prompt index tables in prompts/README.md and SKILL.md from
 * schema.yaml `checks:`. Generated, never hand-maintained, so the index can
 * never disagree with the validator about which checks a section owns.
 */

$root = dirname(__DIR__, 3);
$autoload = $root.'/vendor/autoload.php';

if (!is_file($autoload)) {
    fwrite(STDERR, "generate-prompt-index: cannot locate vendor/autoload.php\n");
    exit(2);
}

require $autoload;

$schema = Schema::fromFile($root.'/config/issues/schema.yaml');

/**
 * Build the gate-codes cell for a section from its schema checks.
 *
 * @param  string  $id
 * @return string
 */
function sectionCodes(string $id, Schema $schema): string
{
    $checks = $schema->checksFor($id);

    if ($checks === []) {
        return '—';
    }

    return implode(', ', array_map(
        static fn (string $code): string => '`'.$code.'`',
        array_keys($checks),
    ));
}

// Section id => (prompt file, description) for the README table.
$readmeRows = [
    'acceptance-criteria' => ['write-acceptance-criteria.md', ''],
    'prompt-preamble' => ['prompt-preamble.md', '— citation rule, stop rule (`D#`), tier rule, prohibitions'],
    'core-metadata' => [null, '— scripted'],
    'problem-statement' => ['write-problem-statement.md', ''],
    'feature-scope' => ['write-feature-scope.md', 'and the `D#` shape (`D#. <question>? Options: <a>, <b>. Default: <a>.`)'],
    'dependency-matrix' => ['write-dependency-matrix.md', 'none — lists only packages the change touches, never "just in case"'],
    'affected-surface' => ['write-affected-surface.md', ''],
    'artifacts' => ['write-artifacts.md', ''],
    'runtime-state' => ['write-runtime-state.md', 'none'],
    'impact-profile' => ['write-impact-profile.md', ''],
    'epistemic-matrix' => ['write-epistemic-matrix.md', ''],
    'source-grounding' => ['write-source-grounding.md', ''],
    'orchestrate-issue-conversion' => ['orchestrate-issue-conversion.md', 'none — fixes the §7.7 writing order and assembles the final body (no section code)'],
    'review-issue-body' => ['review-issue-body.md', 'none — adversarial read of the assembled body; lists rejectable lines (no section code)'],
];

// Section id => (prompt file, description) for the SKILL.md table.
$skillRows = [
    'core-metadata' => [null, '— scripted'],
    'problem-statement' => ['prompts/write-problem-statement.md', ''],
    'feature-scope' => ['prompts/write-feature-scope.md', ''],
    'dependency-matrix' => ['prompts/write-dependency-matrix.md', '—'],
    'affected-surface' => ['prompts/write-affected-surface.md', ''],
    'artifacts' => ['prompts/write-artifacts.md', ''],
    'runtime-state' => ['prompts/write-runtime-state.md', '—'],
    'acceptance-criteria' => ['prompts/write-acceptance-criteria.md', ''],
    'source-grounding' => ['prompts/write-source-grounding.md', ''],
    'impact-profile' => ['prompts/write-impact-profile.md', ''],
    'epistemic-matrix' => ['prompts/write-epistemic-matrix.md', ''],
];

function renderReadmeRow(string $id, array $row, Schema $schema): string
{
    [$promptFile, $desc] = $row;

    // Cross-cutting prompts are not schema sections — no checks from schema.
    if ($id === 'prompt-preamble') {
        return '| (shared rules) | `prompt-preamble.md` | — citation rule, stop rule (`D#`), tier rule, prohibitions |';
    }

    if ($id === 'orchestrate-issue-conversion') {
        return '| `orchestrate-issue-conversion` | `orchestrate-issue-conversion.md` | none — fixes the §7.7 writing order and assembles the final body (no section code) |';
    }

    if ($id === 'review-issue-body') {
        return '| `review-issue-body` | `review-issue-body.md` | none — adversarial read of the assembled body; lists rejectable lines (no section code) |';
    }

    if ($id === 'core-metadata') {
        return '| `core-metadata` | none — scripted | `parent-mismatch` (read from labels and the sub-issue link; no agent writes this section) |';
    }

    $section = '`'.$id.'`';
    $prompt = '`'.$promptFile.'`';
    $codes = sectionCodes($id, $schema);

    if ($id === 'feature-scope') {
        $codes = '`non-goals-missing` and the `D#` shape (`D#. <question>? Options: <a>, <b>. Default: <a>.`)';
    } elseif ($desc !== '' && $codes === '—') {
        $codes = $desc;
    } elseif ($desc !== '') {
        $codes = $codes.' '.$desc;
    }

    return '| '.$section.' | '.$prompt.' | '.$codes.' |';
}

function renderSkillRow(string $id, array $row, Schema $schema): string
{
    [$promptFile, $desc] = $row;

    if ($id === 'core-metadata') {
        $section = '`core-metadata`';
        $prompt = 'none — scripted';
        $codes = '`parent-mismatch` (read from labels and the sub-issue link; D22, no agent writes this section)';
    } else {
        $section = '`'.$id.'`';
        $prompt = '`'.$promptFile.'`';
        $codes = sectionCodes($id, $schema);
        if ($desc === '—') {
            $codes = '—';
        } elseif ($desc !== '' && $codes !== '—') {
            // descriptions only apply to core-metadata in SKILL table; others use raw codes
        }
    }

    return '| '.$section.' | '.$prompt.' | '.$codes.' |';
}

$readmeTable = "## Index: section → prompt → checks owned\n\n";
$readmeTable .= "| Section | Prompt | Gate codes owned |\n";
$readmeTable .= "| --- | --- | --- |\n";

foreach ($readmeRows as $id => $row) {
    $readmeTable .= renderReadmeRow($id, $row, $schema)."\n";
}

$skillTable = "## Writing the sections\n\n";
$skillTable .= "| Section | Prompt | Gate codes the section owns |\n";
$skillTable .= "| --- | --- | --- |\n";

foreach ($skillRows as $id => $row) {
    $skillTable .= renderSkillRow($id, $row, $schema)."\n";
}

$readmePath = $root.'/.agents/skills/file-issue/prompts/README.md';
$skillPath = $root.'/.agents/skills/file-issue/SKILL.md';

$readmeContent = file_get_contents($readmePath);
$skillContent = file_get_contents($skillPath);

// Replace the table portion in README.md (between the index heading and the
// "Reachable through --prompt" heading).
$readmeContent = preg_replace(
    '/^## Index: section → prompt → checks owned\n\n\| Section.*\| --- \| --- \| --- \|\n(?:.*\n)*?(?=\n## Reachable through)/s',
    rtrim($readmeTable)."\n",
    $readmeContent,
);

// Replace the table portion in SKILL.md (between "## Writing the sections" and
// "The full rule text").
$skillContent = preg_replace(
    '/^## Writing the sections\n\n\| Section.*\| --- \| --- \| --- \|\n(?:.*\n)*?(?=The full rule text)/s',
    rtrim($skillTable)."\n",
    $skillContent,
);

file_put_contents($readmePath, $readmeContent);
file_put_contents($skillPath, $skillContent);

echo "wrote prompt index tables to prompts/README.md and SKILL.md\n";
