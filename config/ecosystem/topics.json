{
    "version": 1,
    "roadmaps": {
        "plan:phase-f-protocol-packages": {"title": "Phase F — protocol packages"},
        "spec:plugin-stack-oms-multiprotocol": {"title": "Plugin stack OMS — multiprotocol"},
        "plan:php-arazzo-spec-suite-plan-index": {"title": "Spec suite plan index"},
        "plan:expression-evaluation-parity-hardening": {"title": "Expression evaluation parity hardening"},
        "plan:phase-e-runner-oms": {"title": "Phase E — runner OMS"},
        "upstream:OAI/Arazzo-Specification#410": {"title": "Arazzo 1.2 discussion (#410)"}
    },
    "topics": {
        "wsdl": {
            "title": "Support WSDL/SOAP source type",
            "match": ["\\bwsdl\\b", "\\bsoap\\b"],
            "scope": ["OAI/Arazzo-Specification", "OAI/sig-*"],
            "roadmap": ["plan:phase-f-protocol-packages"],
            "weight": 5
        },
        "protobuf": {
            "title": "Support protobuf source type",
            "match": ["\\bprotobuf\\b", "\\bprotocol[ -]?buffer\\b"],
            "roadmap": ["plan:phase-f-protocol-packages"],
            "weight": 5
        },
        "graphql": {
            "title": "Support GraphQL source type",
            "match": ["\\bgraphql\\b"],
            "roadmap": ["plan:phase-f-protocol-packages"],
            "weight": 5
        },
        "grpc": {
            "title": "Support gRPC source type",
            "match": ["\\bgrpc\\b"],
            "roadmap": ["plan:phase-f-protocol-packages"],
            "weight": 4
        },
        "a2a": {
            "title": "Support A2A protocol sources",
            "match": ["\\bA2A\\b"],
            "caseSensitive": true,
            "roadmap": ["plan:phase-f-protocol-packages"],
            "weight": 4
        },
        "mcp": {
            "title": "Expose workflows as MCP tools",
            "match": ["\\bmcp\\b", "model context protocol"],
            "roadmap": ["plan:phase-f-protocol-packages"],
            "weight": 3
        },
        "xpath": {
            "title": "Support XPath target selectors",
            "match": ["\\bxpath\\b"],
            "roadmap": ["spec:plugin-stack-oms-multiprotocol"],
            "weight": 4
        },
        "xml": {
            "title": "Support application/xml payloads",
            "match": ["\\bxml\\b", "application/xml"],
            "roadmap": ["spec:plugin-stack-oms-multiprotocol"],
            "weight": 3
        },
        "json-schema": {
            "title": "Track JSON Schema / spec suite",
            "match": ["json[ -]?schema", "\\$schema\\b", "\\bjsonschema\\b"],
            "roadmap": ["plan:php-arazzo-spec-suite-plan-index"],
            "weight": 3
        },
        "criterion-regex": {
            "title": "Criterion regex (ECMA-262) parity",
            "match": ["\\bcriterion\\b", "\\bECMA-?262\\b"],
            "roadmap": ["plan:expression-evaluation-parity-hardening"],
            "weight": 2
        },
        "retry-outputs": {
            "title": "Runner retry/outputs semantics",
            "match": ["\\bretry\\b"],
            "roadmap": ["plan:phase-e-runner-oms"],
            "weight": 2
        },
        "actor-in-loop": {
            "title": "Actor-in-the-loop steps",
            "match": ["human[ -]in[ -]the[ -]loop", "actor[ -]in[ -]the[ -]loop"],
            "roadmap": ["upstream:OAI/Arazzo-Specification#410"],
            "weight": 3
        },
        "cli": {
            "title": "arazzo CLI",
            "match": ["\\barazzo[ -]cli\\b", "\\bcommand[ -]line\\b"],
            "roadmap": ["plan:php-arazzo-spec-suite-plan-index"],
            "weight": 2
        },
        "runner": {
            "title": "Runner step execution parity",
            "match": ["\\brunner\\b", "\\bstep execution\\b", "success action", "failure action", "\\bretrylimit\\b"],
            "roadmap": ["plan:phase-e-runner-oms"],
            "weight": 2
        },
        "loop": {
            "title": "Workflow loops / iteration",
            "match": ["\\bgoto\\b", "step loop", "loop step", "retry loop", "iteration loop"],
            "roadmap": ["plan:phase-e-runner-oms"],
            "weight": 2
        },
        "security": {
            "title": "Security schemes / message-level security",
            "match": ["\\bjose\\b", "json web", "security scheme", "sensitive data", "message level security"],
            "roadmap": ["plan:php-arazzo-spec-suite-plan-index"],
            "weight": 3
        },
        "moonwalk": {
            "title": "sig-moonwalk alignment",
            "sources": ["OAI/sig-moonwalk"],
            "roadmap": ["plan:php-arazzo-spec-suite-plan-index"],
            "weight": 3
        },
        "1.2-discussion": {
            "title": "Arazzo 1.2 discussion items",
            "match": ["1\\.2[- ](?:discussion|ideas|breaking changes)", "start of discussion/ideas"],
            "weight": 2
        }
    },
    "sources": {
        "OAI/Arazzo-Specification": 5,
        "OAI/sig-*": 4,
        "swaggerexpert/*": 4,
        "strefethen/arazzo-cli": 3,
        "usearazzo/*": 3,
        "jentic/arazzo-engine": 3,
        "Redocly/redocly-cli": 3,
        "speclynx/apidom": 2
    },
    "trackedLibraries": [
        "swaggerexpert/*",
        "strefethen/arazzo-cli",
        "jentic/arazzo-engine",
        "usearazzo/arazzo-toolkit",
        "Redocly/redocly-cli"
    ],
    "noise": {
        "authors": ["*[bot]", "dependabot", "renovate", "github-actions"],
        "sources": ["Mohammed-Alama/php-arazzo", "jentic/jentic-public-apis"],
        "title": [
            "\\bbump\\b",
            "(?:chore|build)\\(deps(?:-dev)?\\)",
            "^\\s*v\\d+(?:\\.\\d+)*-dev:\\s*sync with dev",
            "^\\s*(?:docs|ci|style|test|chore)(?:\\(|:)",
            "\\btypo\\b"
        ]
    }
}
