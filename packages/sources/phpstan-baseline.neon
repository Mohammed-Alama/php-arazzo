parameters:
	ignoreErrors:
		-
			message: '#^Method resolveParameters has too high cyclomatic complexity \(15\)\. Maximum allowed is 10\.$#'
			count: 1
			path: src/Normalizer/OpenApi30Normalizer.php

		-
			message: '#^Method resolveServerUrl has too high cyclomatic complexity \(19\)\. Maximum allowed is 10\.$#'
			count: 1
			path: src/Normalizer/OpenApi30Normalizer.php

		-
			message: '#^Method resolve has too high cyclomatic complexity \(37\)\. Maximum allowed is 10\.$#'
			count: 1
			path: src/Normalizer/OpenApiOperationResolver.php

		-
			message: '#^Cannot cast mixed to string\.$#'
			identifier: cast.string
			count: 1
			path: src/Resolver/Fetchers/CachedFetcher.php

		-
			message: '#^Method checkStep has too high cyclomatic complexity \(17\)\. Maximum allowed is 10\.$#'
			count: 1
			path: src/Validator/PreflightValidator.php

