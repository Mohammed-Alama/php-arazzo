includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - phpstan-baseline.neon
parameters:
    level: max
    paths:
        - src
    excludePaths:
        - tests
    scanDirectories:
        - vendor/alama/arazzo-core/src
        - vendor/alama/arazzo-contracts/src
        - vendor/alama/arazzo-expression/src
        - vendor/alama/arazzo-document/src
        - vendor/alama/arazzo-runner/src
        - vendor/alama/arazzo-cli/src
