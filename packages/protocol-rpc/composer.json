{
    "name": "alama/arazzo-protocol-rpc",
    "description": "Protocol-Buffer RPC vertical slice for alama/arazzo-core: gRPC, gRPC-Web, Twirp and Connect executors + RpcResponseTransfer. The .proto parser ships inside this package (DF11 vendored-codec exception); transport is contracts' HttpClientInterface (DF9). Zero framework.",
    "keywords": [
        "alama",
        "arazzo",
        "grpc",
        "grpc-web",
        "twirp",
        "connect",
        "protobuf",
        "rpc",
        "protocol"
    ],
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "../contracts"
        },
        {
            "type": "path",
            "url": "../document"
        },
        {
            "type": "path",
            "url": "../expression"
        },
        {
            "type": "path",
            "url": "../evaluation"
        },
        {
            "type": "path",
            "url": "../engine"
        },
        {
            "type": "path",
            "url": "../sources"
        }
    ],
    "require": {
        "php": "^8.4",
        "alama/arazzo-contracts": "@dev",
        "alama/arazzo-document": "@dev",
        "alama/arazzo-engine": "@dev",
        "alama/arazzo-evaluation": "@dev",
        "alama/arazzo-expression": "@dev",
        "alama/arazzo-sources": "@dev",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-arch": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Alama\\Arazzo\\Protocol\\Rpc\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Alama\\Arazzo\\Tests\\Protocol\\Rpc\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
