parameters:
	ignoreErrors:
		-
			message: '#^Method __construct has too many parameters \(6\)\. Maximum allowed is 5\.$#'
			identifier: arazzo.custom.maxParameterCount
			count: 1
			path: src/Data/ExpressionReference.php

		-
			message: '#^Method __construct has too many parameters \(6\)\. Maximum allowed is 5\.$#'
			identifier: arazzo.custom.maxParameterCount
			count: 1
			path: src/Exceptions/ExpressionSyntaxException.php

		-
			message: '#^Method Alama\\Arazzo\\Expression\\JsonPath\\Parser\:\:__construct\(\) has parameter \$tokens with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/JsonPath/Parser.php

		-
			message: '#^Method parsePrimary has too high cyclomatic complexity \(17\)\. Maximum allowed is 10\.$#'
			identifier: arazzo.custom.cyclomaticComplexity
			count: 1
			path: src/JsonPath/Parser.php

		-
			message: '#^Class Rfc9535Engine has too many methods \(30\)\. Maximum allowed is 20\.$#'
			identifier: arazzo.custom.maxMethodCount
			count: 1
			path: src/JsonPath/Rfc9535Engine.php

		-
			message: '#^Method Alama\\Arazzo\\Expression\\JsonPath\\Rfc9535Engine\:\:evaluateExists\(\) has parameter \$expression with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/JsonPath/Rfc9535Engine.php

		-
			message: '#^Method Alama\\Arazzo\\Expression\\JsonPath\\Rfc9535Engine\:\:evaluateLogical\(\) has parameter \$predicate with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/JsonPath/Rfc9535Engine.php

		-
			message: '#^Method Alama\\Arazzo\\Expression\\JsonPath\\Rfc9535Engine\:\:evaluatePath\(\) has parameter \$expression with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/JsonPath/Rfc9535Engine.php

		-
			message: '#^Method Alama\\Arazzo\\Expression\\JsonPath\\Rfc9535Engine\:\:recursiveDescent\(\) has parameter \$child with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/JsonPath/Rfc9535Engine.php

		-
			message: '#^Method Alama\\Arazzo\\Expression\\JsonPath\\Rfc9535Engine\:\:slice\(\) has parameter \$step with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/JsonPath/Rfc9535Engine.php

		-
			message: '#^Method recursiveDescent has too high cyclomatic complexity \(12\)\. Maximum allowed is 10\.$#'
			identifier: arazzo.custom.cyclomaticComplexity
			count: 1
			path: src/JsonPath/Rfc9535Engine.php

		-
			message: '#^Method Alama\\Arazzo\\Expression\\JsonPath\\Tokenizer\:\:matchDot\(\) has parameter \$tokens with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/JsonPath/Tokenizer.php

		-
			message: '#^Method Alama\\Arazzo\\Expression\\JsonPath\\Tokenizer\:\:matchNumber\(\) has parameter \$tokens with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/JsonPath/Tokenizer.php

		-
			message: '#^Method Alama\\Arazzo\\Expression\\JsonPath\\Tokenizer\:\:matchOperator\(\) has parameter \$tokens with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/JsonPath/Tokenizer.php

		-
			message: '#^Method Alama\\Arazzo\\Expression\\JsonPath\\Tokenizer\:\:matchSingleChar\(\) has parameter \$tokens with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
