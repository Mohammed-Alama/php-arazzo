includes:
    - ../core/phpstan/rules/phpstan-custom.neon
    - phpstan-baseline.neon

parameters:
    level: max
    paths:
        - src
    excludePaths:
        - tests
    scanDirectories:
        - ../contracts/src
        - ../document/src
        - ../expression/src
        - ../runner/src
    reportUnmatchedIgnoredErrors: false
