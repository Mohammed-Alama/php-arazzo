includes:
    - ../core/phpstan/rules/phpstan-custom.neon
    - phpstan-baseline.neon

parameters:
    level: max
    paths:
        - src
    excludePaths:
        - tests
    scanDirectories:
        - ../contracts/src
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        - '#Class .* has too many methods#'
        - '#Method .* has too many parameters#'
