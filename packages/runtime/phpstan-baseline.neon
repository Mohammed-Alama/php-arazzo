parameters:
	ignoreErrors:
		-
			message: '#^Class ExecutionContext has too many methods \(31\)\. Maximum allowed is 20\.$#'
			identifier: arazzo.custom.maxMethodCount
			count: 1
			path: src/State/Data/ExecutionContext.php

		-
			message: '#^Method __construct has too many parameters \(13\)\. Maximum allowed is 5\.$#'
			identifier: arazzo.custom.maxParameterCount
			count: 1
			path: src/State/Data/ExecutionContext.php

		-
			message: '#^Method start has too many parameters \(6\)\. Maximum allowed is 5\.$#'
			identifier: arazzo.custom.maxParameterCount
			count: 1
			path: src/State/Data/ExecutionContext.php

		-
			message: '#^Method __construct has too many parameters \(12\)\. Maximum allowed is 5\.$#'
			identifier: arazzo.custom.maxParameterCount
			count: 1
			path: src/State/Data/StepResult.php

		-
			message: '#^Method failure has too many parameters \(10\)\. Maximum allowed is 5\.$#'
			identifier: arazzo.custom.maxParameterCount
			count: 1
			path: src/State/Data/StepResult.php

		-
			message: '#^Method success has too many parameters \(9\)\. Maximum allowed is 5\.$#'
			identifier: arazzo.custom.maxParameterCount
			count: 1
			path: src/State/Data/StepResult.php
