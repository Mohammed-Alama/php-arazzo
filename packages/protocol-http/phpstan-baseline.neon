parameters:
	ignoreErrors:
		-
			message: '#^Method execute has too high cyclomatic complexity \(19\)\. Maximum allowed is 10\.$#'
			identifier: arazzo.custom.cyclomaticComplexity
			count: 1
			path: src/Execution/DefaultOpenApiExecutor.php

		-
			message: '#^Method castOutputAgainstResponseSchema has too high cyclomatic complexity \(11\)\. Maximum allowed is 10\.$#'
			identifier: arazzo.custom.cyclomaticComplexity
			count: 1
			path: src/Execution/StepOutputExtractor.php

		-
			message: '#^Method name ''castOutputAgainstResponseSchema'' length \(31\) is outside allowed range \(3\-30\)\.$#'
			identifier: arazzo.custom.identifierLength
			count: 1
			path: src/Execution/StepOutputExtractor.php

		-
			message: '#^Method __construct has too many parameters \(6\)\. Maximum allowed is 5\.$#'
			identifier: arazzo.custom.maxParameterCount
			count: 1
			path: src/Protocol/AsyncApiStepExecutor.php

		-
			message: '#^Method __construct has too many parameters \(7\)\. Maximum allowed is 5\.$#'
			identifier: arazzo.custom.maxParameterCount
			count: 1
			path: src/Protocol/HttpStepExecutor.php

		-
			message: '#^Method __construct has too many parameters \(12\)\. Maximum allowed is 5\.$#'
			identifier: arazzo.custom.maxParameterCount
			count: 1
			path: src/Registrar/ProtocolHttpRegistrar.php
