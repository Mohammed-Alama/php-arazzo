[
  {
    "id": "accessor-index-member-001",
    "description": "zero-based index followed by property de-reference on a response body list",
    "condition": "$response.body.items[0].id == 1",
    "context": {
      "stepId": "s1",
      "response": {
        "statusCode": 200,
        "headers": {},
        "body": {
          "items": [
            { "id": 1, "name": "one" },
            { "id": 2, "name": "two" }
          ]
        }
      }
    },
    "expected": true,
    "spec": "Arazzo 1.1.0, Criterion Object, Operators: [] Index (0-based), . Property de-reference"
  },
  {
    "id": "accessor-property-chain-002",
    "description": "chained property de-references",
    "condition": "$response.body.nested.a.b == 42",
