{
    "name": "php-arazzo/arazzo-engine",
    "description": "Arazzo workflow engine - step state machine and workflow transition logic",
    "type": "library",
    "version": "1.0.0-alpha.1",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "php-arazzo/arazzo-contracts": "@dev",
        "open-telemetry/api": "^1.1",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "pestphp/pest": "^5.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Alama\\Arazzo\\Engine\\": "src/",
            "Alama\\Arazzo\\Runtime\\": "src/Runtime/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Alama\\Arazzo\\Tests\\Engine\\": "tests/",
            "Alama\\Arazzo\\Tests\\Runtime\\": "tests/Runtime/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
