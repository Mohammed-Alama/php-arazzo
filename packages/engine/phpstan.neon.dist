includes:
    - ../core/phpstan/rules/phpstan-custom.neon
    - phpstan-baseline.neon

parameters:
    level: max
    paths:
        - src
    excludePaths:
        - tests
    scanDirectories:
        - ../contracts/src
        - ../runtime/src
    reportUnmatchedIgnoredErrors: true
    ignoreErrors:
        -
            message: '#Method .* has too many parameters#'
        -
            message: '#Property DateInterval::\$f .* not nullable#'
        -
            message: '#Property .* is never read, only written#'
        -
            message: '#Strict comparison using !== between int and null will always evaluate to true#'
        -
            message: '#Strict comparison using !== between string and null will always evaluate to true#'
        -
            message: '#Strict comparison using !== between array and null will always evaluate to true#'
        -
            message: '#Method validateObject has too high cyclomatic complexity#'
        -
            message: '#Parameter \#1 \$array \(list<mixed>\) of array_values is already a list#'
        -
            message: '#Strict comparison using === between string and null will always evaluate to false#'
        -
            message: '#Method validateNumber has too high cyclomatic complexity#'
        -
            message: '#Method validate has too high cyclomatic complexity#'