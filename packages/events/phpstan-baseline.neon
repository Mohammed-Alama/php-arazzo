		-
			message: '#^Method __construct has too many parameters \(7\)\. Maximum allowed is 5\.$#'
			identifier: arazzo.custom.maxParameterCount
			count: 1
			path: src/StepExecutedEvent.php

		-
			message: '#^Method __construct has too many parameters \(6\)\. Maximum allowed is 5\.$#'
			identifier: arazzo.custom.maxParameterCount
			count: 1
			path: src/StepFailedEvent.php

		-
			message: '#^Method __construct has too many parameters \(6\)\. Maximum allowed is 5\.$#'
			identifier: arazzo.custom.maxParameterCount
			count: 1
			path: src/StepRetriedEvent.php
