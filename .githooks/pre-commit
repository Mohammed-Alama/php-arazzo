#!/usr/bin/env bash
set -e

echo "========================================"
echo "    Running Pre-Commit Checks..."
echo "========================================"

# Determine the project root from git
PROJECT_ROOT=$(git rev-parse --show-toplevel)
cd "$PROJECT_ROOT"

echo "0. Checking composer.lock is in step with the root composer.json..."
if ! composer run check-lock; then
    echo "========================================"
    echo "❌ composer run check-lock failed."
    echo "   Usual cause: composer.lock no longer matches the root composer.json."
    echo "💡 Run: composer update"
    echo "   CI installs from this lock, so a stale one fails the build."
    echo "   If the command itself did not run, read what it printed above."
    echo "========================================"
    exit 1
fi
echo "✅ composer.lock is in step with the root composer.json."
echo ""

echo "1. Regenerating architecture docs (mermaid)..."
if ! php scripts/generate-docs.php; then
    echo "========================================"
    echo "❌ Doc generation failed!"
    echo "💡 Fix the error from scripts/generate-docs.php shown above."
    echo "   (skip with: git commit --no-verify)"
    echo "========================================"
    exit 1
fi
if [ -n "$(git status --porcelain -- docs/generated)" ]; then
    git add docs/generated
    echo "   📚 docs/generated changed — staged automatically."
fi
echo "✅ Docs up to date."
echo ""

echo "2. Checking Code Style (Pint)..."
if ! vendor/bin/pint --test -v; then
    echo "========================================"
    echo "❌ Code style check failed!"
    echo "💡 Fix it by running: composer format"
    echo "========================================"
    exit 1
fi
echo "✅ Code Style passed."
echo ""

echo "3. Running Static Analysis (PHPStan)..."
if ! composer analyse; then
    echo "========================================"
    echo "❌ Static analysis failed!"
    echo "💡 Fix the PHPStan errors shown above."
    echo "========================================"
    exit 1
fi
echo "✅ Static Analysis passed."
echo ""

echo "4. Checking PHPStan baseline policy..."
if ! composer run check-baselines; then
    echo "========================================"
    echo "❌ A correctness error is hidden in a PHPStan baseline!"
    echo "💡 Fix the underlying error — it must not be baselined."
    echo "   Only entries without an identifier, and missingType.*, may be baselined."
    echo "========================================"
    exit 1
fi
echo "✅ Baseline policy passed."
echo ""

echo "5. Running Tests (Pest/PHPUnit)..."
if ! composer test; then
    echo "========================================"
    echo "❌ Tests failed!"
    echo "💡 Fix the failing tests shown above."
    echo "========================================"
    exit 1
fi
echo "✅ Tests passed."
echo ""

echo "6. Checking Spec Conformance (warn-only)..."
if ! php scripts/generate-conformance-matrix.php >/dev/null 2>&1; then
    echo "⚠️  Conformance matrix check failed (network or corpus issue) — continuing."
else
    echo "✅ Spec Conformance matrix generated."
fi
echo ""

echo "🎉 All checks passed! Committing..."
