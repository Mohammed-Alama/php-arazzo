#!/usr/bin/env bash
# Mirrors CI gates: docs regeneration, pint --test, phpstan, pest.
# Skip with `git push --no-verify` if you truly need to.
set -euo pipefail

remote="${1:-}"
ref="${2:-}"

# Only gate pushes to protected branches.
protected_re='^(refs/heads/main|refs/heads/master)$'
run_checks=false
while read -r local_ref local_sha remote_ref remote_sha; do
    [[ -z "${remote_ref:-}" ]] && continue
    if [[ "$remote_ref" =~ $protected_re ]]; then
        run_checks=true
        break
    fi
done

if [[ "$run_checks" != true ]]; then
    exit 0
fi

echo "==> pre-push: running CI-equivalent gates before push to protected branch"

fail() { echo "!! pre-push blocked: $1" >&2; exit 1; }

command -v php >/dev/null || fail "php not found on PATH"
[[ -x vendor/bin/pint ]]    || fail "vendor/bin/pint missing — run composer install"

echo "--> make verify"
make verify || fail "make verify failed"

# make verify regenerates docs/generated — a push ships already-made commits,
# so stale docs cannot be fixed in-flight: block instead.
if [ -n "$(git status --porcelain -- docs/generated)" ]; then
    git status --short -- docs/generated >&2
    fail "docs/generated is stale — commit the regenerated docs, then push again"
fi

echo "==> pre-push: all checks passed"
